<section class="section section--alt flavors-section" id="clients">
	<h2 id="title-list-client">Liste des clients</h2>
	<button id="btn-add-client">Ajouter un client</button>
	<div id="clients-list"></div>

	<div id="modal-overlay" class="modal-overlay hidden">
		<div class="modal-card">
			<div class="modal-header">
				<h2>Nouveau client</h2>
				<button id="modal-close">&times;</button>
			</div>
			<form id="form-client">
				<div class="form-group">
					<label for="client-nom">Nom *</label>
					<input type="text" id="client-nom" required>
				</div>
				<div class="form-group">
					<label for="client-email">Email *</label>
					<input type="email" id="client-email" required>
				</div>
				<div class="form-group">
					<label for="client-tel">Téléphone</label>
					<input type="tel" id="client-tel">
				</div>
				<div class="form-group">
					<label for="client-entreprise">Entreprise</label>
					<input type="text" id="client-entreprise">
				</div>
				<button type="submit" class="btn-submit">Valider</button>
			</form>
		</div>
	</div>

	<div id="modal-overlay-delete" class="modal-overlay hidden">
		<div class="modal-card">
			<div class="modal-header">
				<h2>Suppression d'un client</h2>
				<button id="modal-close-delete">&times;</button>
			</div>
			<h3 id="message-delete-client"></h3>
			<button id="confirmeDelete">Confirmer</button>
		</div>
	</div>
</section>
