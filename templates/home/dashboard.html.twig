<section class="hero" id="hero">

	<section class="section dashboard" id="dashboard">
		<h2 class="dashboard-title">Tableau de bord</h2>
		<div class="kpi-grid" id="kpi-grid">
			<div class="kpi-card" id="kpi-ca">
				<div class="kpi-icon">💰</div>
				<div class="kpi-content">
					<p class="kpi-label">Chiffre d'affaires</p>
					<p class="kpi-value" id="kpi-ca-value">—</p>
				</div>
			</div>
			<div class="kpi-card" id="kpi-envoyees">
				<div class="kpi-icon">📄</div>
				<div class="kpi-content">
					<p class="kpi-label">Factures envoyées</p>
					<p class="kpi-value" id="kpi-envoyees-value">—</p>
				</div>
			</div>
			<div class="kpi-card kpi-warning" id="kpi-attente">
				<div class="kpi-icon">⏳</div>
				<div class="kpi-content">
					<p class="kpi-label">En attente</p>
					<p class="kpi-value" id="kpi-attente-value">—</p>
				</div>
			</div>
			<div class="kpi-card kpi-danger" id="kpi-retard">
				<div class="kpi-icon">❌</div>
				<div class="kpi-content">
					<p class="kpi-label">En retard</p>
					<p class="kpi-value" id="kpi-retard-value">—</p>
				</div>
			</div>
		</div>
		<div class="chart-card">
			<p class="chart-title">Chiffre d'affaires par semaine</p>
			<canvas id="chart-ca-semaine"></canvas>
		</div>
	</section>
</section>
