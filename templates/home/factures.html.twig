<!-- ======= TOPPING BUILDER ======= -->
<section class="section builder" id="factures">
	<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
		<h2>Factures</h2>
		<button id="btn-add-facture" class="btn btn-primary">+ Nouvelle facture</button>
	</div>

	<div id="factures-list"></div>

	<div id="modal-overlay-facture" class="modal-overlay hidden">
		<div class="modal">
			<div class="modal-header">
				<h3 id="modal-title-facture">Nouvelle facture</h3>
				<button id="modal-close-facture">✕</button>
			</div>
			<form id="form-facture">
				<div class="field">
					<label for="facture-client">Client</label>
					<select id="facture-client">
						<option value="">— Sélectionner un client —</option>
					</select>
				</div>
				<div class="field-row">
					<div class="field">
						<label for="facture-date">Date de la facture</label>
						<input type="date" id="facture-date"/>
					</div>
					<div class="field">
						<label for="facture-echeance">Date d'échéance</label>
						<input type="date" id="facture-echeance"/>
					</div>
				</div>
				<div class="field-row">
					<div class="field">
						<label for="facture-total">Total (€)</label>
						<input type="number" id="facture-total" placeholder="0.00" min="0" step="0.01"/>
					</div>
					<div class="field">
						<label for="facture-status">Statut</label>
						<select id="facture-status">
							<option value="draft">Brouillon</option>
							<option value="sent">Envoyée</option>
							<option value="paid">Payée</option>
							<option value="late">En retard</option>
						</select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" id="btn-cancel-facture">Annuler</button>
					<button type="submit" id="btn-submit-facture">Créer</button>
				</div>
			</form>
		</div>
	</div>
</section>
