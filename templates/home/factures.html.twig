<!-- ======= TOPPING BUILDER ======= -->
<section class="section builder" id="factures">
	<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
		<h2>Factures</h2>
		<button id="btn-add-facture" class="btn btn-primary">+ Nouvelle facture</button>
	</div>

	<div id="factures-list"></div>

	<div id="modal-overlay-facture" class="modal-overlay hidden">
		<div class="modal">
			<div class="modal-header">
				<h3 id="modal-title-facture">Nouvelle facture</h3>
				<button id="modal-close-facture">✕</button>
			</div>
			<form id="form-facture">
				<div class="field">
					<label for="facture-client">Client</label>
					<select id="facture-client">
						<option value="">— Sélectionner un client —</option>
					</select>
				</div>

				<div class="field-row">
					<div class="field">
						<label for="facture-date">Date de la facture</label>
						<input type="date" id="facture-date"/>
					</div>
					<div class="field">
						<label for="facture-echeance">Date d'échéance</label>
						<input type="date" id="facture-echeance"/>
					</div>
				</div>

				<div class="field">
					<label for="facture-status">Statut</label>
					<select id="facture-status">
						<option value="draft">Brouillon</option>
						<option value="sent">Envoyée</option>
						<option value="paid">Payée</option>
						<option value="late">En retard</option>
					</select>
				</div>

				<!-- Lignes de facturation -->
				{#<div class="items-header">
									<span>Description</span>
									<div style="display: grid; grid-template-columns: 1fr 1fr 1fr 28px; gap: 8px;">
										<span>Qté</span>
										<span>Prix unit.</span>
										<span>Total</span>
										<span></span>
									</div>
								</div>#}

				<div id="facture-items"></div>

				<button type="button" id="btn-add-item">+ Ajouter une ligne</button>

				<div class="facture-total-line">
					<span>Total</span>
					<span id="facture-total-display">0,00 €</span>
					<input type="hidden" id="facture-total"/>
				</div>

				<div class="modal-footer">
					<button type="button" id="btn-cancel-facture">Annuler</button>
					<button type="submit" id="btn-submit-facture">Créer</button>
				</div>
			</form>
		</div>
	</div>

	<div id="modal-overlay-facture-delete" class="modal-overlay hidden">
		<div class="modal-card">
			<div class="modal-header">
				<h2>Suppression d'une facture client</h2>
				<button id="modal-close-delete-facture">&times;</button>
			</div>
			<h3 id="message-delete-facture"></h3>
			<button id="confirmeDeleteFacture">Confirmer</button>
		</div>
	</div>
</section>
